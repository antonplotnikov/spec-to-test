# Copy this file to .env and fill in values. Never commit .env.
# The app works fully without any of these settings.
# On Streamlit Community Cloud, put the same keys in the app's Secrets instead
# (see .streamlit/secrets.toml.example).

# Optional AI analysis. Leave as "none" to stay fully offline.
# Set to "anthropic" and add a key to enable the AI analysis tab
# (also run: pip install -r requirements-ai.txt).
AI_PROVIDER=none
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5

# Where edits are kept:
#   local   = saved to disk and restored next time (default on your computer)
#   session = kept only in the browser session (default on Streamlit Cloud)
# SPEC_TO_TEST_STORAGE=local
# SPEC_TO_TEST_DATA_DIR=
