# Copy this file to .env and fill in values. Never commit .env.
# The app works fully without any of these settings.
# On Streamlit Community Cloud, put the same keys in the app's Secrets instead
# (see .streamlit/secrets.toml.example).

# Optional AI (AI analysis tab, Grill Mode AI interviewer and test ideas, Automation).
# Leave as "none" to stay fully offline: every rule-based feature keeps working.
# AI_PROVIDER is the default provider: anthropic (alias: claude), openai or ollama.
# Any other provider whose key is set below can be picked per session in the
# sidebar ("AI settings"). Also run: pip install -r requirements-ai.txt
AI_PROVIDER=none
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=            # optional: an OpenAI-compatible gateway
# OLLAMA_HOST=http://localhost:11434   # local models, no key, data stays on this machine
# Models (optional). AI_MODEL applies to the AI_PROVIDER provider.
# AI_MODEL=claude-opus-5-5
# ANTHROPIC_MODEL=claude-opus-5-5
# OPENAI_MODEL=gpt-5
# OLLAMA_MODEL=llama3.1
# Shared deployments: show the AI settings read-only (no provider/model changes).
# AI_LOCK_SETTINGS=true

# Storage (SPEC_TO_TEST_STORAGE) is NOT read from this file, on purpose, so a
# stray .env can never switch a shared deployment to saving documents on disk.
# The default is "session" (work kept only in the browser session, nothing on
# disk). To save work on your own computer, set it in the process environment
# (or in .streamlit/secrets.toml), only on a single-user machine:
#   SPEC_TO_TEST_STORAGE=local streamlit run app.py

# Optional Automation tab (see README "Automation"). Like the storage mode,
# these are NOT read from this file by the app: set them in the process
# environment or Streamlit secrets. docker compose does read this file and
# passes the values into the container's environment.
# AUTOMATION_ALLOWED_HOSTS=staging.example.com
# AUTOMATION_ALLOW_PRIVATE_NETWORK=false
# AUTOMATION_SECRET_STAGING_PASSWORD=
