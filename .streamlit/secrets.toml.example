# Template for Streamlit secrets. Copy the keys you need into
# Streamlit Community Cloud -> App settings -> Secrets
# (or into .streamlit/secrets.toml locally, which is git-ignored).
# Root-level keys are exposed to the app as environment variables.

# Keep work only in each visitor's browser session. This is the default
# everywhere; setting it explicitly documents the intent. Never set "local"
# on a public or shared app: all visitors would share one folder on the server.
SPEC_TO_TEST_STORAGE = "session"

# Optional AI analysis. On a public app every visitor's run uses YOUR key and
# YOUR budget; leave these out unless you accept that.
# AI_PROVIDER = "anthropic"        # or "openai"
# ANTHROPIC_API_KEY = ""
# OPENAI_API_KEY = ""
# AI_MODEL = "claude-opus-5-5"
# Recommended on a public app: visitors cannot switch provider or model.
# AI_LOCK_SETTINGS = "true"

# Optional Automation tab: staging hosts the browser may open (empty = off),
# and credentials tests may type, referenced by name (STAGING_PASSWORD).
# Needs the Node toolchain (automation/runner), so not Streamlit Cloud.
# AUTOMATION_ALLOWED_HOSTS = "staging.example.com"
# AUTOMATION_SECRET_STAGING_PASSWORD = ""
